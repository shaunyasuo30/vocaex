{
  "name": "vocamate-extension",
  "displayName": "VocaMate",
  "version": "0.2.1",
  "description": "Tra và lưu từ tiếng Anh ngay trên trang web",
  "author": "BN_team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "postbuild": "node scripts/copy-notice.mjs",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "cmu-pronouncing-dictionary": "^3.0.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://translate.googleapis.com/*",
      "https://freedictionaryapi.com/*"
    ],
    "permissions": [
      "storage",
      "activeTab"
    ]
  }
}
